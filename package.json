{
  "name": "huddle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sync": "wrangler dev --config worker/wrangler.jsonc",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d --wait",
    "test:sync": "node --test --test-force-exit tests/sync.test.mjs",
    "setup": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.28",
    "@blocknote/code-block": "^0.57.0",
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lib0": "^0.2.120",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "y-partyserver": "^2.2.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "y-partyserver": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
