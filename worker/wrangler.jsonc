{
  // The Huddle sync server: one Durable Object per page, on Cloudflare's free plan.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "huddle-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": { "APP_ORIGIN": "http://localhost:3000" },
  "durable_objects": { "bindings": [{ "name": "Doc", "class_name": "DocRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],

  // `wrangler deploy --env production`. The AI binding needs a Cloudflare account,
  // so it is left out locally to keep local development account-free.
  "env": {
    "production": {
      "name": "huddle-sync",
      "vars": { "APP_ORIGIN": "https://viraj-huddle.vercel.app", "AI_MODEL": "@cf/zai-org/glm-4.7-flash" },
      "ai": { "binding": "AI" },
      "durable_objects": { "bindings": [{ "name": "Doc", "class_name": "DocRoom" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }]
    }
  }
}
