# Copy to .env.local for local work. Never commit real values.
# Make each secret with:  openssl rand -base64 48

# Local: the Docker database. Production: your Neon "pooled" connection string.
DATABASE_URL=postgres://huddle:huddle_local_only@127.0.0.1:5433/huddle

# The public address of the web app, with no trailing slash.
APP_URL=http://localhost:3000

BETTER_AUTH_SECRET=

# Must be identical in worker/.dev.vars (local) and the Cloudflare secret (production).
SYNC_SECRET=
# How the web app reaches the sync server.
SYNC_URL=http://127.0.0.1:8787
# How browsers reach it: host only, no https://. Read at build time.
NEXT_PUBLIC_SYNC_HOST=localhost:8787

# Email. Required in production. Leave empty locally to print links in the terminal.
# Gmail: turn on 2-Step Verification, then create an "app password".
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com

# Optional social sign-in. A button appears only when both values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
